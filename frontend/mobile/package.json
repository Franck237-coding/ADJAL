{
  "name": "@adjal/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm exec expo start --localhost --port 8081",
    "dev:go": "pnpm exec expo start --lan --port 8081",
    "setup:env": "node scripts/setup-env.mjs",
    "build": "pnpm run validate:expo-compatibility && pnpm run validate:mobile && node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:critical-flows": "node --test scripts/critical-flows.test.mjs",
    "validate:expo-compatibility": "node scripts/check-expo-compatibility.mjs",
    "validate:mobile": "node scripts/validate-mobile-release.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/cli": "~57.0.0",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.90.21",
    "@types/react": "~19.2.3",
    "@types/react-dom": "~19.2.3",
    "@ungap/structured-clone": "^1.3.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.0",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "playwright": "1.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "~1.22.6",
    "react-native-reanimated": "~4.5.5",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "~15.15.5",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "~0.10.4",
    "typescript": "~5.9.2",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.4.0"
  }
}
